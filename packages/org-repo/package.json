{
  "name": "@numinia/org-repo",
  "version": "0.37.0",
  "description": "Each organization's private repository: made from the organization template by numinia.com's GitHub App, with the licence reserved in the organization's name. Fail-closed config, WinterCG-pure.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@numinia/state": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
