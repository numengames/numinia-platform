---
import RitualPage from '../../../../components/communities/RitualPage.astro';
import { rituals, communityOf } from '../../../../components/communities/register';

export function getStaticPaths() {
  return rituals().map((ritual) => ({
    params: { id: ritual.id },
    props: { ritual, community: communityOf(ritual.community) },
  }));
}

const { community } = Astro.props;
/** Settled at render (register.ts): the paths may be listed before the clock runs. */
const ritual =
  rituals().find((entry) => entry.id === Astro.props.ritual.id) ?? Astro.props.ritual;
---

<RitualPage locale="ja" ritual={ritual} community={community} />
